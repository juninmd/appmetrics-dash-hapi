{
  "name": "appmetrics-dash-hapi",
  "version": "1.0.5",
  "description": "Adaptation of appmetrics-dash for Hapi.js - provides a dashboard for monitoring Node.js application metrics",
  "main": "index.js",
  "license": "Apache-2.0",
  "author": "IBM Node.js Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/juninmd/appmetrics-dash-hapi"
  },
  "bugs": {
    "url": "https://github.com/juninmd/appmetrics-dash-hapi/issues"
  },
  "homepage": "https://github.com/juninmd/appmetrics-dash-hapi",
  "keywords": [
    "appmetrics",
    "hapi",
    "dashboard",
    "monitoring",
    "metrics"
  ],
  "dependencies": {
    "appmetrics": "^3.1.0",
    "appmetrics-dash": "^5.3.0",
    "debug": "^2.6.0",
    "hapi": "18.1.0",
    "inert": "5.1.3",
    "node-report": "^2.1.0",
    "socket.io": "^2.0.3"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "prettier": "^3.2.4",
    "proxyquire": "^2.1.3",
    "sinon": "^17.0.1",
    "socket.io-client": "^2.5.0"
  },
  "scripts": {
    "lint": "eslint index.js test/",
    "lint:fix": "eslint --fix index.js test/",
    "format": "prettier --write '**/*.js' '**/*.json' '**/*.md'",
    "format:check": "prettier --check '**/*.js' '**/*.json' '**/*.md'",
    "test": "mocha 'test/**/*.test.js' --timeout 10000",
    "test:coverage": "nyc --reporter=lcov --reporter=text --reporter=text-summary mocha 'test/**/*.test.js' --timeout 10000",
    "pretest": "yarn lint",
    "build": "echo 'No build step required'",
    "prepack": "yarn test:coverage",
    "audit": "yarn audit --level high"
  },
  "engines": {
    "node": ">=8.0.0"
  },
  "nyc": {
    "all": true,
    "include": [
      "index.js"
    ],
    "exclude": [
      "test/",
      "example/",
      "coverage/"
    ],
    "reporter": [
      "lcov",
      "text",
      "text-summary"
    ],
    "check-coverage": true,
    "branches": 80,
    "lines": 80,
    "functions": 80,
    "statements": 80
  }
}
